# ----------------------------------------------------------------------------
# ReproLab configuration — copy to .env and fill in real values.
# .env is git-ignored. Never commit real keys; never paste keys into source.
# ----------------------------------------------------------------------------

# --- NVIDIA Nemotron via Nebius Token Factory (model inference) -------------
# Get a key at https://tokenfactory.nebius.com (Access keys / API keys).
NEBIUS_API_KEY=replace-with-your-nebius-token-factory-key

# OpenAI-compatible API root for Nebius Token Factory.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA open-source model id. ReproLab validates this against the live
# GET /v1/models list for YOUR account at startup. If the id is not available
# to you, ReproLab reports the mismatch and (when NEBIUS_MODEL_AUTOSELECT=true)
# falls back to another Nemotron model your account can actually use.
# Published ids differ in casing between Nebius pages, so let the live list win.
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL_AUTOSELECT=true

# --- Tavily (research + documentation retrieval) ----------------------------
# Get a key at https://app.tavily.com
TAVILY_API_KEY=replace-with-your-tavily-key
TAVILY_BASE_URL=https://api.tavily.com

# --- Execution runner -------------------------------------------------------
# "docker" is the only supported backend. If Docker is unavailable ReproLab
# refuses to run the experiment and says what to install -- it never falls
# back to executing untrusted repository code on the host.
REPROLAB_RUNNER_BACKEND=docker
REPROLAB_RUNNER_IMAGE=python:3.11-slim

# Hard caps enforced in application code (not by the model).
REPROLAB_MAX_RUNTIME_SECONDS=900
REPROLAB_STEP_TIMEOUT_SECONDS=420
REPROLAB_CONTAINER_CPUS=2.0
REPROLAB_CONTAINER_MEMORY_MB=4096
REPROLAB_CONTAINER_PIDS_LIMIT=256
REPROLAB_MAX_LOG_BYTES=1048576
REPROLAB_MAX_WORKSPACE_MB=2048
REPROLAB_MAX_DOWNLOAD_BYTES=20971520
REPROLAB_MAX_REPAIRS=2

# TLS trust bundle to mount read-only into the dependency-install phase.
# Needed only behind a TLS-intercepting corporate/agent proxy. Leave blank
# otherwise. No application credentials are ever passed to containers.
REPROLAB_RUNNER_CA_BUNDLE=

# --- Repository access policy ----------------------------------------------
# false (default): only the curated repositories in backend/reprolab/curated.py
# may be executed. Set true ONLY for a private, authenticated owner instance:
# it allows executing arbitrary public GitHub repositories.
REPROLAB_ALLOW_ARBITRARY_REPOS=false

# Optional shared-secret gate for write endpoints. If set, clients must send
# `X-ReproLab-Token: <value>`. Strongly recommended for any public deployment.
REPROLAB_API_TOKEN=

# --- Storage / server -------------------------------------------------------
REPROLAB_DATA_DIR=./data
REPROLAB_HOST=127.0.0.1
REPROLAB_PORT=8000
REPROLAB_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
